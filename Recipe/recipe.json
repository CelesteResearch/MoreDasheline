      "segments": [
        {
          "literal": "using System;\nusing System.Collections.Generic;\nusing System.Reflection;\nusing System.Runtime.CompilerServices;\nusing Celeste.Core.Display;\nusing Celeste.Everest.Content.Reloading;\nusing Celeste.Game.Execution.LevelLoader;\nusing Celeste.Game.Execution.Levels;\nusing Celeste.Graphics.Display.Colors;\nusing Celeste.Mods.MoreDasheline.Modules;\nusing Celeste.Simulation;\nusing Celeste.Simulation.Gameplay.Player.Presentation.Hair;\nusing Celeste.Simulation.Gameplay.Player.Presentation.Sprites;\nusing MonoMod.RuntimeDetour;\n\nnamespace Celeste.Mods.MoreDasheline.Runtime\n{\n    public sealed class MoreDashPlayerHooks : IDisposable\n    {\n        private readonly List<IDisposable> hooks = new();\n        private readonly MoreDashelineModule module;\n\n        public MoreDashPlayerHooks(MoreDashelineModule module)\n        {\n            this.module = module;\n            try\n            {\n                hooks.Add(new Hook(Method(\"Update\"), (Action<Action<RoomPlayerSession>, RoomPlayerSession>)Update));\n                hooks.Add(new Hook(Method(\"StartDash\"),\n                    (Func<Func<RoomPlayerSession, int>, RoomPlayerSession, int>)StartDash));\n                hooks.Add(new Hook(Method(\"GetTrailColor\"),\n                    (Func<Func<RoomPlayerSession, bool, PackedColor>, RoomPlayerSession, bool, PackedColor>)\n                    GetTrailColor));\n            }\n            catch\n            {\n                Dispose();\n                throw;\n            }\n        }\n\n        private static MethodInfo Method(string name) => typeof(RoomPlayerSession).GetMethod(name,\n                                                             BindingFlags.Instance | BindingFlags.Public |\n                                                             BindingFlags.NonPublic | BindingFlags.DeclaredOnly)\n                                                         ?? throw new MissingMethodException(\n                                                             typeof(RoomPlayerSession).FullName, name);\n\n"
        },
        {
          "literal": "        private int StartDash(Func<RoomPlayerSession, int> orig, RoomPlayerSession player)\n        {\n            if (!ReferenceEquals(player.EngineContext, module.Engine))\n            { return orig(player); }\n"

          "literal": "using System;\nusing System.Runtime.CompilerServices;\nusing Celeste.Core.Scheduling;\nusing Celeste.Everest.Modules.Runtime;\nusing Celeste.Mods.MoreDasheline.Configuration;\nusing Celeste.Mods.MoreDasheline.Runtime;\n\nnamespace Celeste.Mods.MoreDasheline.Modules\n{\n    public sealed class MoreDashelineModule : SourceEverestModule\n    {\n        private static readonly ConditionalWeakTable<ISourceEngineContext, MoreDashelineModule> modules = new();\n        private MoreDashPlayerHooks hooks;\n\n        internal readonly ConditionalWeakTable<Celeste.Simulation.RoomPlayerSession, MoreDashPlayerState>\n            PlayerHistory = new();\n\n        internal bool CapturedOverrideHairColor;\n\n        public MoreDashelineModule(ISourceEngineContext engine) : base(engine)\n        {\n        }\n\n        public ISourceEngineContext Engine => SourceEngine;\n        public MoreDashSettings Settings => (MoreDashSettings)_Settings;\n        public MoreDashSession Session => (MoreDashSession)_Session;\n        public override Type SessionType => typeof(MoreDashSession);\n        public override Type SettingsType => typeof(MoreDashSettings);\n\n        public static MoreDashelineModule For(ISourceEngineContext engine) =>\n            modules.TryGetValue(engine, out var module)\n                ? module\n                : throw new InvalidOperationException(\"MoreDasheline is not loaded for this engine.\");\n\n        public override void Load()\n        {\n            modules.Add(SourceEngine, this);\n            try\n            {\n                hooks = new MoreDashPlayerHooks(this);\n            }\n            catch\n            {\n                modules.Remove(SourceEngine);\n                throw;\n            }\n        }\n\n        public override void Unload()\n        {\n            hooks?.Dispose();\n            hooks = null;\n            modules.Remove(SourceEngine);\n        }\n\n"
